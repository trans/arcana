#!/bin/bash
#
# arcana setup — Machine/user-level setup for the Arcana agent bus.
#
# Idempotent. Run once (or after upgrades). Installs:
#   1. Hook scripts to ~/.claude/hooks/ (shared by every Claude Code session)
#   2. Hook config into ~/.claude/settings.json
#   3. Pre-approval rules for mcp__arcana__* into ~/.claude/settings.json
#      (so sub-agents don't hang on permission prompts)
#   4. Global MCP registration (`claude mcp add arcana --scope user -- arcana-mcp`)
#      if the `claude` CLI is available
#
# Nothing is per-project — the hooks read each project's .ai/config.yml
# at hook time (falling back to @<directory name>), so one setup covers
# every project. Codex gets the same hooks when ~/.codex exists.
#
# Usage:
#   arcana setup             # do the setup
#   arcana setup --verify    # setup + round-trip echo test against the daemon
#   arcana setup --help
#

set -euo pipefail

VERIFY=0
for arg in "$@"; do
  case "$arg" in
    --verify) VERIFY=1 ;;
    --help|-h)
      cat <<'HELP'
arcana setup — machine/user-level setup

Installs hook scripts, hook config, permission allow-rules, and MCP
registration. Idempotent — safe to re-run.

Options:
  --verify   After setup, do a round-trip echo test via the daemon.
             Confirms the tool + hook + daemon path all work end-to-end.
  --help     This message.

Reads no env vars. Writes to:
  ~/.claude/hooks/arcana-*.sh
  ~/.claude/settings.json
  ~/.claude.json (via `claude mcp add`)
  ~/.codex/hooks/arcana-*.sh and ~/.codex/hooks.json (if ~/.codex exists)
HELP
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      echo "Try: arcana setup --help" >&2
      exit 1
      ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CLAUDE_DIR="$HOME/.claude"
HOOKS_DIR="$CLAUDE_DIR/hooks"
SETTINGS="$CLAUDE_DIR/settings.json"

# Find arcana-mcp binary
if [ -x "$SCRIPT_DIR/arcana-mcp" ]; then
  MCP_BIN="$SCRIPT_DIR/arcana-mcp"
elif command -v arcana-mcp >/dev/null 2>&1; then
  MCP_BIN="$(command -v arcana-mcp)"
else
  echo "Error: arcana-mcp not found on PATH. Install the arcana package or build locally." >&2
  exit 1
fi

echo "Arcana setup"
echo "  MCP binary: $MCP_BIN"
echo ""

# --- 1. Install hook scripts ---
#
# Each hook is a one-line wrapper around `arcana hook <event>`, which does
# the work for both agents: the handle and description come from the
# project's .ai/config.yml (falling back to @<directory name>), the
# registration carries the project's owner token, session start tells the
# agent who it is on the bus, and session end moves unread mail into
# .ai/inbox/ and marks the handle offline instead of unregistering it.

# write_hook <path> <event> <agent> <comment>
write_hook() {
  cat > "$1" << HOOK
#!/bin/bash
# $4
# Installed by \`arcana setup\`; the logic lives in \`arcana hook\`.
command -v arcana >/dev/null 2>&1 || exit 0
exec arcana hook $2 --agent $3
HOOK
  chmod +x "$1"
}

mkdir -p "$HOOKS_DIR"
write_hook "$HOOKS_DIR/arcana-register.sh"   session-start claude "SessionStart hook: register this project's agent on the Arcana bus."
write_hook "$HOOKS_DIR/arcana-mail.sh"       stop          claude "Stop hook: ask the agent to read waiting Arcana mail before it stops."
write_hook "$HOOKS_DIR/arcana-unregister.sh" session-end   claude "SessionEnd hook: move unread mail to .ai/inbox/, mark the handle offline."
echo "  Hooks installed → $HOOKS_DIR/arcana-*.sh"

# --- 2. Merge hooks + permission allow-rules into settings.json ---

mkdir -p "$CLAUDE_DIR"

# Pre-approve every mcp__arcana__* tool call. Without this, sub-agents
# spawned by AIX (or any headless Claude Code launch) freeze on the first
# arcana tool call waiting for a permission click that never comes.
SETTINGS_ADD='{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "~/.claude/hooks/arcana-register.sh" }] }],
    "Stop":         [{ "hooks": [{ "type": "command", "command": "~/.claude/hooks/arcana-mail.sh"     }] }],
    "SessionEnd":   [{ "hooks": [{ "type": "command", "command": "~/.claude/hooks/arcana-unregister.sh" }] }]
  },
  "permissions": {
    "allow": ["mcp__arcana__*"]
  }
}'

if [ -f "$SETTINGS" ]; then
  # Merge into existing settings. `*` is jq's recursive merge — preserves
  # sibling keys, replaces on conflict at leaves. permissions.allow is
  # replaced wholesale rather than appended; if the user has custom allow
  # rules already, they need to add mcp__arcana__* themselves. (The `*`
  # merge doesn't concat arrays. Live with it — this is user-scoped.)
  MERGED=$(jq -s '.[0] * .[1]' "$SETTINGS" <(echo "$SETTINGS_ADD"))
  echo "$MERGED" > "$SETTINGS"
  echo "  Settings merged → $SETTINGS"
else
  echo "$SETTINGS_ADD" | jq . > "$SETTINGS"
  echo "  Settings created → $SETTINGS"
fi

# --- 2b. Codex hooks (only when Codex is installed) ---
#
# Same wrappers, --agent codex. Existing entries in ~/.codex/hooks.json
# are left exactly as they are: Codex asks the user to trust each hook
# entry, and rewriting one would ask again.

CODEX_DIR="$HOME/.codex"
if [ -d "$CODEX_DIR" ]; then
  CODEX_HOOKS="$CODEX_DIR/hooks"
  mkdir -p "$CODEX_HOOKS"
  write_hook "$CODEX_HOOKS/arcana-register.sh"   session-start codex "Codex SessionStart hook: register this project's agent on the Arcana bus."
  write_hook "$CODEX_HOOKS/arcana-mail.sh"       stop          codex "Codex Stop hook: continue once when this project's Arcana inbox has mail."
  write_hook "$CODEX_HOOKS/arcana-unregister.sh" session-end   codex "Codex SessionEnd hook: move unread mail to .ai/inbox/, mark the handle offline."

  CODEX_JSON="$CODEX_DIR/hooks.json"
  [ -f "$CODEX_JSON" ] || echo '{"hooks":{}}' > "$CODEX_JSON"
  MERGED=$(jq --arg dir "$CODEX_HOOKS" '
    def ensure(ev; entry):
      (entry.hooks[0].command) as $cmd
      | .hooks[ev] = ((.hooks[ev] // [])
          | if any(.[]?; any(.hooks[]?; .command == $cmd)) then . else . + [entry] end);
    .hooks //= {}
    | ensure("SessionStart"; {matcher: "startup|resume|clear",
        hooks: [{type: "command", command: "\($dir)/arcana-register.sh", timeout: 3, statusMessage: "Registering with Arcana"}]})
    | ensure("Stop"; {hooks: [{type: "command", command: "\($dir)/arcana-mail.sh", timeout: 3}]})
    | ensure("SessionEnd"; {hooks: [{type: "command", command: "\($dir)/arcana-unregister.sh", timeout: 3}]})
  ' "$CODEX_JSON")
  if [ "$(jq -cS . "$CODEX_JSON")" != "$(echo "$MERGED" | jq -cS .)" ]; then
    echo "$MERGED" > "$CODEX_JSON"
    echo "  Codex hooks installed → $CODEX_HOOKS/arcana-*.sh (+ $CODEX_JSON)"
  else
    echo "  Codex hooks installed → $CODEX_HOOKS/arcana-*.sh ($CODEX_JSON already lists them)"
  fi
fi

# --- 3. Register MCP server globally (user scope) ---

if command -v claude >/dev/null 2>&1; then
  # `claude mcp add` fails loudly if the name is already registered.
  # Detect first, only add if absent.
  if claude mcp list 2>/dev/null | grep -q '^arcana:'; then
    echo "  MCP already registered (user scope) — leaving as-is"
  else
    if claude mcp add arcana --scope user -- "$MCP_BIN" >/dev/null 2>&1; then
      echo "  MCP registered → claude mcp add arcana --scope user"
    else
      echo "  MCP registration failed. Run manually: claude mcp add arcana --scope user -- $MCP_BIN" >&2
    fi
  fi
else
  echo "  \`claude\` CLI not on PATH — skipping MCP registration."
  echo "     After installing Claude Code, run:"
  echo "     claude mcp add arcana --scope user -- $MCP_BIN"
fi

echo ""
echo "Setup complete."

# --- 4. Optional: verify round-trip ---

if [ "$VERIFY" -eq 1 ]; then
  echo ""
  echo "Verifying round-trip against the daemon..."

  if ! curl -sf http://127.0.0.1:19118/health >/dev/null; then
    echo "  Daemon isn't reachable on http://127.0.0.1:19118 — start it with:" >&2
    echo "     sudo systemctl start arcana" >&2
    exit 1
  fi

  # deliver {tool:echo, ping:pong} → expect a Protocol.result echoing back.
  # from="" skips the check_sender! check (the verify probe isn't a
  # registered participant on the bus, and doesn't need to be for a
  # one-shot sync round-trip — server assigns an ephemeral reply mailbox).
  http_status=0
  reply=$(curl -s -o /tmp/arcana-verify.$$ -w "%{http_code}" \
    http://127.0.0.1:19118/deliver \
    -H "Content-Type: application/json" \
    -d '{"from":"","to":"arcana","payload":{"tool":"echo","ping":"pong"},"ordering":"sync","timeout_ms":3000}' \
    2>/dev/null) && http_status=$reply
  body=$(cat /tmp/arcana-verify.$$ 2>/dev/null || echo "")
  rm -f /tmp/arcana-verify.$$

  if [ "$http_status" = "200" ] && echo "$body" | jq -e '.payload._status == "result" and .payload.data.ping == "pong"' >/dev/null 2>&1; then
    echo "  Round-trip OK — arcana Toolset is live, replies routed correctly."
  else
    echo "  Round-trip FAILED." >&2
    echo "    HTTP status: $http_status" >&2
    echo "    Body:        $body" >&2
    exit 1
  fi
fi
